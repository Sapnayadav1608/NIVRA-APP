{
  "name": "nivra-app",
  "version": "1.0.0",
  "description": "NIVRA - AI Powered Women Safety App",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "start": "npm run server:start",
    "server:start": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm start",
    "client:build": "cd client && npm run build",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed": "cd database && node seedData.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test",
    "build": "npm run client:build",
    "heroku-postbuild": "npm run install:all && npm run build"
  },
  "keywords": [
    "women-safety",
    "emergency",
    "pwa",
    "ai",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "NIVRA Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/nivra-app.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/nivra-app/issues"
  },
  "homepage": "https://nivra-app.herokuapp.com"
}